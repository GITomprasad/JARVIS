# ==============================================================================
# JARVIS Backend Configuration
# ==============================================================================

# LLM Provider: 'gemini', 'anthropic', 'openai', or 'mock' (offline test mode)
LLM_PROVIDER=gemini

# API Keys
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Name
# For Gemini: gemini-3.6-flash
# For Anthropic: claude-3-5-sonnet-20241022
# For OpenAI: gpt-4o
LLM_MODEL=gemini-3.6-flash

# Conversation Memory
# Number of past messages (user + assistant) to include as context in each LLM call
MAX_HISTORY_MESSAGES=10

# Database
# Local SQLite database path (default: ./jarvis.db)
DATABASE_URL=sqlite:///./jarvis.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
